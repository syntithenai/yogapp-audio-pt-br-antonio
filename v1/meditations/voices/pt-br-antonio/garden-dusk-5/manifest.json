{
  "id": "garden-dusk-5",
  "voiceId": "pt-br-antonio",
  "edgeVoice": "pt-BR-AntonioNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 336,
  "chunks": [
    {
      "index": 0,
      "text": "Bem-vindo.",
      "file": "c000.ogg",
      "durationSec": 2.904
    },
    {
      "index": 1,
      "text": "Sente-se confortavelmente, ou deite-se se isso sentir melhor.",
      "file": "c001.ogg",
      "durationSec": 7.92
    },
    {
      "index": 2,
      "text": "Deixe as mãos repousarem.",
      "file": "c002.ogg",
      "durationSec": 4.152
    },
    {
      "index": 3,
      "text": "Permita que os olhos se fechem, ou suavize o olhar.",
      "file": "c003.ogg",
      "durationSec": 6.864
    },
    {
      "index": 4,
      "text": "Perceba o peso do seu corpo sendo sustentado.",
      "file": "c004.ogg",
      "durationSec": 6.336
    },
    {
      "index": 5,
      "text": "Inspire devagar pelo nariz.",
      "file": "c005.ogg",
      "durationSec": 4.512
    },
    {
      "index": 6,
      "text": "E expire mais lentamente e com facilidade.",
      "file": "c006.ogg",
      "durationSec": 5.88
    },
    {
      "index": 7,
      "text": "Novamente. Inspiração suave.",
      "file": "c007.ogg",
      "durationSec": 6.648
    },
    {
      "index": 8,
      "text": "Expiração gentil.",
      "file": "c008.ogg",
      "durationSec": 3.816
    },
    {
      "index": 9,
      "text": "Se os pensamentos vagarem, isso está bem. Volte para a respiração.",
      "file": "c009.ogg",
      "durationSec": 10.128
    },
    {
      "index": 10,
      "text": "Imagine um jardim tranquilo cercado de muros ao entardecer suave.",
      "file": "c010.ogg",
      "durationSec": 8.208
    },
    {
      "index": 11,
      "text": "Caminhos de pedra retêm o último calor do dia.",
      "file": "c011.ogg",
      "durationSec": 6.168
    },
    {
      "index": 12,
      "text": "Sinta aquele calor gentil pelas solas dos pés.",
      "file": "c012.ogg",
      "durationSec": 6.48
    },
    {
      "index": 13,
      "text": "Lavanda e rosas da tarde liberam um aroma calmo.",
      "file": "c013.ogg",
      "durationSec": 6.552
    },
    {
      "index": 14,
      "text": "Uma brisa fresca desliza sobre o muro e refresca seu pescoço.",
      "file": "c014.ogg",
      "durationSec": 7.632
    },
    {
      "index": 15,
      "text": "O ar é fresco após uma tarde quente.",
      "file": "c015.ogg",
      "durationSec": 5.52
    },
    {
      "index": 16,
      "text": "Você caminha devagar entre arbustos aparados suavemente como a respiração.",
      "file": "c016.ogg",
      "durationSec": 8.808
    },
    {
      "index": 17,
      "text": "Os dedos tocam folhas ainda segurando o sol.",
      "file": "c017.ogg",
      "durationSec": 6.024
    },
    {
      "index": 18,
      "text": "Quente. Suave. Vivo.",
      "file": "c018.ogg",
      "durationSec": 7.584
    },
    {
      "index": 19,
      "text": "Um banco de madeira aguarda sob uma árvore tranquila.",
      "file": "c019.ogg",
      "durationSec": 6.696
    },
    {
      "index": 20,
      "text": "Você senta. A madeira está agradavelmente quente contra sua costas.",
      "file": "c020.ogg",
      "durationSec": 9.816
    },
    {
      "index": 21,
      "text": "Acima, o céu torna-se lavanda e rosa.",
      "file": "c021.ogg",
      "durationSec": 6.192
    },
    {
      "index": 22,
      "text": "As aves se acolhem. O jardim adquire silêncio.",
      "file": "c022.ogg",
      "durationSec": 7.848
    },
    {
      "index": 23,
      "text": "Sinta o calor suavemente desaparecendo das pedras e da madeira.",
      "file": "c023.ogg",
      "durationSec": 7.656
    },
    {
      "index": 24,
      "text": "Sinta a frescor crescente da noite em seu rosto.",
      "file": "c024.ogg",
      "durationSec": 6.264
    },
    {
      "index": 25,
      "text": "Inale o aroma e a quietude.",
      "file": "c025.ogg",
      "durationSec": 4.536
    },
    {
      "index": 26,
      "text": "Exale o dia que você carregou.",
      "file": "c026.ogg",
      "durationSec": 4.704
    },
    {
      "index": 27,
      "text": "Uma mariposa passa pela última luz dourada.",
      "file": "c027.ogg",
      "durationSec": 6.192
    },
    {
      "index": 28,
      "text": "Nada aqui é urgente. Tudo é suficiente.",
      "file": "c028.ogg",
      "durationSec": 7.44
    },
    {
      "index": 29,
      "text": "Descanse nessa suficiência.",
      "file": "c029.ogg",
      "durationSec": 4.752
    },
    {
      "index": 30,
      "text": "Deixe sua barriga amolecer no ar do crepúsculo.",
      "file": "c030.ogg",
      "durationSec": 6.264
    },
    {
      "index": 31,
      "text": "Deixe sua próxima respiração ser a mais silenciosa do dia.",
      "file": "c031.ogg",
      "durationSec": 7.728
    },
    {
      "index": 32,
      "text": "Dê uma volta lenta pelo caminho antes de terminar.",
      "file": "c032.ogg",
      "durationSec": 6.12
    },
    {
      "index": 33,
      "text": "Pedras quentes esfriando sob os pés.",
      "file": "c033.ogg",
      "durationSec": 5.472
    },
    {
      "index": 34,
      "text": "Os arbustos liberando o perfume armazenado durante o dia.",
      "file": "c034.ogg",
      "durationSec": 7.104
    },
    {
      "index": 35,
      "text": "A brisa agora tem um toque noturno — fresca, quase doce.",
      "file": "c035.ogg",
      "durationSec": 7.896
    },
    {
      "index": 36,
      "text": "Pare no portão sem abri-lo ainda.",
      "file": "c036.ogg",
      "durationSec": 4.776
    },
    {
      "index": 37,
      "text": "Sinta como a calma se instalou nos ombros.",
      "file": "c037.ogg",
      "durationSec": 5.616
    },
    {
      "index": 38,
      "text": "Leve o silêncio do jardim como uma pequena lanterna para dentro.",
      "file": "c038.ogg",
      "durationSec": 7.608
    },
    {
      "index": 39,
      "text": "Agora descanse apenas na respiração por um momento.",
      "file": "c039.ogg",
      "durationSec": 6.72
    },
    {
      "index": 40,
      "text": "Inale lentamente.",
      "file": "c040.ogg",
      "durationSec": 3.696
    },
    {
      "index": 41,
      "text": "Exale lentamente.",
      "file": "c041.ogg",
      "durationSec": 3.84
    },
    {
      "index": 42,
      "text": "Inale.",
      "file": "c042.ogg",
      "durationSec": 2.616
    },
    {
      "index": 43,
      "text": "Exale.",
      "file": "c043.ogg",
      "durationSec": 2.736
    },
    {
      "index": 44,
      "text": "Sinta o calor onde o corpo está quente.",
      "file": "c044.ogg",
      "durationSec": 5.328
    },
    {
      "index": 45,
      "text": "Sinta a frescura onde o ar está frio.",
      "file": "c045.ogg",
      "durationSec": 5.4
    },
    {
      "index": 46,
      "text": "Inale.",
      "file": "c046.ogg",
      "durationSec": 2.616
    },
    {
      "index": 47,
      "text": "Exale.",
      "file": "c047.ogg",
      "durationSec": 2.736
    },
    {
      "index": 48,
      "text": "Nenhum lugar para ir. Nada para consertar.",
      "file": "c048.ogg",
      "durationSec": 7.344
    },
    {
      "index": 49,
      "text": "Inale.",
      "file": "c049.ogg",
      "durationSec": 2.616
    },
    {
      "index": 50,
      "text": "Exale.",
      "file": "c050.ogg",
      "durationSec": 2.736
    },
    {
      "index": 51,
      "text": "Descanse aqui por algumas respirações tranquilas.",
      "file": "c051.ogg",
      "durationSec": 6.816
    },
    {
      "index": 52,
      "text": "Saiba que você pode voltar a este lugar a qualquer momento.",
      "file": "c052.ogg",
      "durationSec": 7.08
    },
    {
      "index": 53,
      "text": "Quando estiver pronto, aprofunde a respiração.",
      "file": "c053.ogg",
      "durationSec": 6.312
    },
    {
      "index": 54,
      "text": "Mova os dedos das mãos e dos pés.",
      "file": "c054.ogg",
      "durationSec": 5.232
    },
    {
      "index": 55,
      "text": "Abra os olhos suavemente.",
      "file": "c055.ogg",
      "durationSec": 4.2
    },
    {
      "index": 56,
      "text": "Leve um pouco dessa paz com você.",
      "file": "c056.ogg",
      "durationSec": 4.872
    }
  ]
}
