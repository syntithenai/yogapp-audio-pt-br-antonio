  "totalSec": 143,
  "chunks": [
    {
      "index": 0,
      "text": "Bem-vindo.",
      "file": "c000.ogg",
      "durationSec": 2.904
    },
    {
      "index": 1,
      "text": "Se você se sentir disperso ou ativado, esta prática pode ajudar.",
      "file": "c001.ogg",
      "durationSec": 8.568
    },
    {
      "index": 2,
      "text": "Mantenha os olhos abertos por enquanto, se isso parecer mais seguro.",
      "file": "c002.ogg",
      "durationSec": 8.616
    },
    {
      "index": 3,
      "text": "Coloque ambos os pés no chão.",
      "file": "c003.ogg",
      "durationSec": 4.872
    },
    {
      "index": 4,
      "text": "[pausa:17]",
      "file": "c004.ogg",
      "durationSec": 3.696
    },
    {
      "index": 5,
      "text": "Nomeie cinco coisas que pode ver.",
      "file": "c005.ogg",
      "durationSec": 4.992
    },
    {
      "index": 6,
      "text": "Silenciosamente. Passe o tempo que precisar.",
      "file": "c006.ogg",
      "durationSec": 7.704
    },
    {
      "index": 7,
      "text": "[pausa:45]",
      "file": "c007.ogg",
      "durationSec": 3.912
    },
    {
      "index": 8,
      "text": "Nomeie quatro coisas que pode sentir ou tocar.",
      "file": "c008.ogg",
      "durationSec": 6.24
    },
    {
      "index": 9,
      "text": "Roupas. Cadeira. Ar na pele. Pés no chão.",
      "file": "c009.ogg",
      "durationSec": 10.896
    },
    {
      "index": 10,
      "text": "[pausa:39]",
      "file": "c010.ogg",
      "durationSec": 3.648
    },
    {
      "index": 11,
      "text": "Nomeie três sons.",
      "file": "c011.ogg",
      "durationSec": 3.936
    },
    {
      "index": 12,
      "text": "Próximo ou distante. Suave ou claro.",
      "file": "c012.ogg",
      "durationSec": 7.152
    },
    {
      "index": 13,
      "text": "[pausa:39]",
      "file": "c013.ogg",
      "durationSec": 3.648
    },
    {
      "index": 14,
      "text": "Nomeie dois aromas, ou simplesmente perceba a qualidade do ar.",
      "file": "c014.ogg",
      "durationSec": 8.496
    },
    {
      "index": 15,
      "text": "[pausa:28]",
      "file": "c015.ogg",
      "durationSec": 3.528
    },
    {
      "index": 16,
      "text": "Nomeie um sabor, ou o sentimento dentro da boca.",
      "file": "c016.ogg",
      "durationSec": 6.552
    },
    {
      "index": 17,
      "text": "[pausa:23]",
      "file": "c017.ogg",
      "durationSec": 3.696
    },
    {
      "index": 18,
      "text": "Você está aqui. Neste corpo. Nesta sala.",
      "file": "c018.ogg",
      "durationSec": 9.48
    },
    {
      "index": 19,
      "text": "Inspire por quatro.",
      "file": "c019.ogg",
      "durationSec": 3.672
    },
    {
      "index": 20,
      "text": "Exale por seis.",
      "file": "c020.ogg",
      "durationSec": 3.72
    },
    {
      "index": 21,
      "text": "[pausa:23]",
      "file": "c021.ogg",
      "durationSec": 3.696
    },
    {
      "index": 22,
      "text": "Faça mais uma respiração fácil.",
      "file": "c022.ogg",
      "durationSec": 5.184
    },
    {
      "index": 23,
      "text": "Balanceie os dedos.",
      "file": "c023.ogg",
      "durationSec": 3.912
    },
    {
      "index": 24,
      "text": "Quando estiver pronto, abra os olhos.",
      "file": "c024.ogg",
      "durationSec": 5.232
    },
    {
      "index": 25,
      "text": "Leve um pouco disso consigo.",
      "file": "c025.ogg",
      "durationSec": 4.752
    }
  ]
}
