  "chunks": [
    {
      "index": 0,
      "text": "Bem-vindo.",
      "file": "c000.ogg",
      "durationSec": 2.904
    },
    {
      "index": 1,
      "text": "Encontre uma posição confortável, ou deite-se se isso parecer melhor.",
      "file": "c001.ogg",
      "durationSec": 8.664
    },
    {
      "index": 2,
      "text": "Deixe as mãos em repouso.",
      "file": "c002.ogg",
      "durationSec": 4.152
    },
    {
      "index": 3,
      "text": "Suavize os olhos, ou feche-os.",
      "file": "c003.ogg",
      "durationSec": 5.448
    },
    {
      "index": 4,
      "text": "Respire lentamente pela narina.",
      "file": "c004.ogg",
      "durationSec": 4.896
    },
    {
      "index": 5,
      "text": "E expire por um tempo mais longo.",
      "file": "c005.ogg",
      "durationSec": 4.992
    },
    {
      "index": 6,
      "text": "Imagine-se sentado perto de uma janela em um dia chuvoso tranquilo.",
      "file": "c006.ogg",
      "durationSec": 7.992
    },
    {
      "index": 7,
      "text": "O vidro está frio. O mundo está suave lá fora.",
      "file": "c007.ogg",
      "durationSec": 7.872
    },
    {
      "index": 8,
      "text": "[pausa:30]",
      "file": "c008.ogg",
      "durationSec": 3.144
    },
    {
      "index": 9,
      "text": "Ouça a chuva sem precisar de uma história.",
      "file": "c009.ogg",
      "durationSec": 5.664
    },
    {
      "index": 10,
      "text": "Taps leves. Quedas mais fortes ocasionalmente.",
      "file": "c010.ogg",
      "durationSec": 8.208
    },
    {
      "index": 11,
      "text": "[pausa:36]",
      "file": "c011.ogg",
      "durationSec": 3.864
    },
    {
      "index": 12,
      "text": "Sinta o ar úmido e limpo.",
      "file": "c012.ogg",
      "durationSec": 4.104
    },
    {
      "index": 13,
      "text": "Veja a luz cinza, suave e serena.",
      "file": "c013.ogg",
      "durationSec": 5.544
    },
    {
      "index": 14,
      "text": "[pausa:30]",
      "file": "c014.ogg",
      "durationSec": 3.144
    },
    {
      "index": 15,
      "text": "Não há lugar para ir na chuva.",
      "file": "c015.ogg",
      "durationSec": 4.584
    },
    {
      "index": 16,
      "text": "Permissão para pausar.",
      "file": "c016.ogg",
      "durationSec": 3.768
    },
    {
      "index": 17,
      "text": "[pausa:36]",
      "file": "c017.ogg",
      "durationSec": 3.864
    },
    {
      "index": 18,
      "text": "Respire com o ritmo da água no vidro.",
      "file": "c018.ogg",
      "durationSec": 5.448
    },
    {
      "index": 19,
      "text": "[pausa:45]",
      "file": "c019.ogg",
      "durationSec": 3.912
    },
    {
      "index": 20,
      "text": "Deixe o sistema nervoso receber o sinal: relaxe.",
      "file": "c020.ogg",
      "durationSec": 7.248
    },
    {
      "index": 21,
      "text": "[pausa:36]",
      "file": "c021.ogg",
      "durationSec": 3.864
    },
    {
      "index": 22,
      "text": "Respire mais uma vez com facilidade.",
      "file": "c022.ogg",
      "durationSec": 5.448
    },
    {
      "index": 23,
      "text": "Mova os dedos.",
      "file": "c023.ogg",
      "durationSec": 3.36
    },
    {
      "index": 24,
      "text": "Quando estiver pronto, abra os olhos.",
      "file": "c024.ogg",
      "durationSec": 5.232
    },
    {
      "index": 25,
      "text": "Leve um pouco disso com você.",
      "file": "c025.ogg",
      "durationSec": 4.776
    }
  ]
