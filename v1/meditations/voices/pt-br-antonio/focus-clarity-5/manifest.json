      "file": "c031.ogg",
      "durationSec": 3.36
    },
    {
      "index": 32,
      "text": "Quando estiver pronto, abra os olhos.",
      "file": "c032.ogg",
      "durationSec": 5.232
    },
    {
      "index": 33,
      "text": "Leve um pouco disso com você.",
      "file": "c033.ogg",
