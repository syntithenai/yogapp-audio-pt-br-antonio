  "chunks": [
    {
      "index": 0,
      "text": "Bem-vindo.",
      "file": "c000.ogg",
      "durationSec": 2.904
    },
    {
      "index": 1,
      "text": "Tome tempo para chegar.",
      "file": "c001.ogg",
      "durationSec": 3.792
    },
    {
      "index": 2,
      "text": "Sente-se ou deite-se com apoio.",
      "file": "c002.ogg",
      "durationSec": 4.728
    },
    {
      "index": 3,
      "text": "Feche os olhos se isso parecer seguro.",
      "file": "c003.ogg",
      "durationSec": 5.448
    },
    {
      "index": 4,
      "text": "Sinta o contato com o chão.",
      "file": "c004.ogg",
      "durationSec": 4.464
    },
    {
      "index": 5,
      "text": "Respiração lenta e profunda.",
      "file": "c005.ogg",
      "durationSec": 4.752
    },
    {
      "index": 6,
      "text": "Respiração longa e lenta.",
      "file": "c006.ogg",
      "durationSec": 4.608
    },
    {
      "index": 7,
      "text": "[pausa:26]",
      "file": "c007.ogg",
      "durationSec": 3.888
    },
    {
      "index": 8,
      "text": "Mais uma vez.",
      "file": "c008.ogg",
      "durationSec": 3.408
    },
    {
      "index": 9,
      "text": "[pausa:26]",
      "file": "c009.ogg",
      "durationSec": 3.888
    },
    {
      "index": 10,
      "text": "Deixe os ombros relaxarem.",
      "file": "c010.ogg",
      "durationSec": 4.344
    },
    {
      "index": 11,
      "text": "Deixe o abdome se suavizar.",
      "file": "c011.ogg",
      "durationSec": 4.536
    },
    {
      "index": 12,
      "text": "[pausa:33]",
      "file": "c012.ogg",
      "durationSec": 3.84
    },
    {
      "index": 13,
      "text": "Permita que o dia termine por enquanto.",
      "file": "c013.ogg",
      "durationSec": 5.16
    },
    {
      "index": 14,
      "text": "O que aconteceu, aconteceu.",
      "file": "c014.ogg",
      "durationSec": 5.016
    },
    {
      "index": 15,
      "text": "O que resta pode esperar até a manhã.",
      "file": "c015.ogg",
      "durationSec": 5.16
    },
    {
      "index": 16,
      "text": "[pausa:33]",
      "file": "c016.ogg",
      "durationSec": 3.84
    },
    {
      "index": 17,
      "text": "Na expiração, imagine colocando tarefas em uma prateleira.",
      "file": "c017.ogg",
      "durationSec": 7.992
    },
    {
      "index": 18,
      "text": "Uma por uma. Sem drama. Apenas coloque.",
      "file": "c018.ogg",
      "durationSec": 9.168
    },
    {
      "index": 19,
      "text": "[pausa:53]",
      "file": "c019.ogg",
      "durationSec": 4.2
    },
    {
      "index": 20,
      "text": "Inale quatro. Exale seis.",
      "file": "c020.ogg",
      "durationSec": 6.504
    },
    {
      "index": 21,
      "text": "[pausa:33]",
      "file": "c021.ogg",
      "durationSec": 3.84
    },
    {
      "index": 22,
      "text": "Suavize o rosto.",
      "file": "c022.ogg",
      "durationSec": 3.624
    },
    {
      "index": 23,
      "text": "Solte os ombros.",
      "file": "c023.ogg",
      "durationSec": 3.504
    },
    {
      "index": 24,
      "text": "Armas pesadas. Pernas pesadas.",
      "file": "c024.ogg",
      "durationSec": 7.032
    },
    {
      "index": 25,
      "text": "[pausa:40]",
      "file": "c025.ogg",
      "durationSec": 3.36
    },
    {
      "index": 26,
      "text": "Se a mente listar novamente, acene para ela e volte à prateleira.",
      "file": "c026.ogg",
      "durationSec": 8.136
    },
    {
      "index": 27,
      "text": "[pausa:53]",
      "file": "c027.ogg",
      "durationSec": 4.2
    },
    {
      "index": 28,
      "text": "Sinta o colchão ou a cadeira sustentando você.",
      "file": "c028.ogg",
      "durationSec": 6.192
    },
    {
      "index": 29,
      "text": "[pausa:66]",
      "file": "c029.ogg",
      "durationSec": 4.248
    },
    {
      "index": 30,
      "text": "Respiração mais calma. Corpo mais pesado.",
      "file": "c030.ogg",
      "durationSec": 7.824
    },
    {
      "index": 31,
      "text": "[pausa:90]",
      "file": "c031.ogg",
      "durationSec": 3.456
    },
    {
      "index": 32,
      "text": "[pausa:40]",
      "file": "c032.ogg",
      "durationSec": 3.36
    },
    {
      "index": 33,
      "text": "Comece a respirar mais profundamente.",
      "file": "c033.ogg",
      "durationSec": 5.592
    },
    {
      "index": 34,
      "text": "Sinta o ambiente novamente.",
      "file": "c034.ogg",
      "durationSec": 4.536
    },
    {
      "index": 35,
      "text": "Balanceie os dedos e os pés.",
      "file": "c035.ogg",
      "durationSec": 4.968
    },
    {
      "index": 36,
      "text": "Quando estiver pronto, abra os olhos.",
      "file": "c036.ogg",
      "durationSec": 5.232
    },
    {
      "index": 37,
      "text": "Mova-se lentamente para o que vem a seguir.",
      "file": "c037.ogg",
      "durationSec": 5.52
    }
  ]
}
