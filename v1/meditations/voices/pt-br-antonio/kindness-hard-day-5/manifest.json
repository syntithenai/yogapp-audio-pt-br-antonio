      "text": "Deixe as mãos repousarem.",
      "file": "c002.ogg",
      "durationSec": 4.152
    },
    {
      "index": 3,
      "text": "Aqueça os olhos, ou feche-os.",
      "file": "c003.ogg",
      "durationSec": 5.016
    },
    {
      "index": 4,
      "text": "Inspire devagar.",
